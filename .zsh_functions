coverage() {
	bzlquery=$(echo "kind(go_test, $1)")
	bazel query "$bzlquery" | xargs bazel coverage --combined_report=lcov
	dir=$(mktemp -d)
	echo "Writing report to $dir/ ..."
	genhtml --quiet --branch-coverage --output "$dir" $(bzl info output_path)/_coverage/_coverage_report.dat
	echo "Opening report in browser..."
	open "$dir/index.html"
}

# Create or open a git worktree in a new tmux window with neovim.
# If the worktree already exists, opens it. Otherwise, creates it at a
# random path under ~/.worktrees/ and tracks it in Graphite.
# Usage: wt <branch> [base-branch]
wt() {
	local repo_flag=()

	# If not inside a git repo, treat the first argument as the repo path.
	if ! git rev-parse --is-inside-work-tree &>/dev/null; then
		if [ -z "$1" ]; then
			echo "Usage (outside a repo): wt <repo-path> <branch> [base-branch]"
			return 1
		fi
		repo_flag=(-C "$1")
		shift
	fi

	if [ -z "$1" ]; then
		git "${repo_flag[@]}" worktree list
		return 0
	fi

	local branch="${1#caramelomartins/}"
	local default_branch
	default_branch=$(git "${repo_flag[@]}" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
	local base="${2:-${default_branch:-main}}"
	local full_branch="caramelomartins/$branch"
	local worktree_path

	# Check if a worktree for this branch already exists.
	worktree_path=$(git "${repo_flag[@]}" worktree list --porcelain | awk -v b="$full_branch" '
		/^worktree / { path = substr($0, 10) }
		/^branch / && $0 ~ b { print path; exit }
	')

	if [ -n "$worktree_path" ]; then
		echo "Opening existing worktree at $worktree_path."
	else
		worktree_path=$(mktemp -d "$HOME/.worktrees/XXXXXX") || return 1

		# mktemp creates the directory, but git worktree add needs it to not exist.
		rmdir "$worktree_path"

		git "${repo_flag[@]}" worktree add -b "$full_branch" "$worktree_path" "$base" || return 1

		# Track the branch in Graphite with the correct parent.
		(cd "$worktree_path" && gt track --parent "$base") || {
			echo "Failed to track branch in Graphite. Cleaning up worktree."
			git "${repo_flag[@]}" worktree remove "$worktree_path"
			return 1
		}
	fi

	tmux new-window -n "$branch" -c "$worktree_path" "claude --continue || claude"
	tmux split-window -h -t "$branch" -c "$worktree_path" "nvim"
	tmux split-window -v -t "$branch" -c "$worktree_path" -l 30%
}

# Remove a git worktree and close its tmux window.
# Looks up the worktree path from "git worktree list" by branch name.
# Usage: wtd <branch> (inside repo) | wtd <repo-path> <branch> (outside repo)
wtd() {
	local repo_flag=()

	if ! git rev-parse --is-inside-work-tree &>/dev/null; then
		if [ -z "$1" ]; then
			echo "Usage (outside a repo): wtd <repo-path> <branch> | wtd <repo-path> --all"
			return 1
		fi
		repo_flag=(-C "$1")
		shift
	fi

	if [ "$1" = "--all" ]; then
		_wtd_cleanup_merged "${repo_flag[@]}"
		return $?
	fi

	if [ -z "$1" ]; then
		echo "Usage: wtd <branch> | wtd --all"
		return 1
	fi

	local branch="$1"
	local full_branch="caramelomartins/$branch"
	local worktree_path
	worktree_path=$(git "${repo_flag[@]}" worktree list --porcelain | awk -v b="$full_branch" '
		/^worktree / { path = substr($0, 10) }
		/^branch / && $0 ~ b { print path; exit }
	')

	if [ -z "$worktree_path" ]; then
		echo "No worktree found for branch '$full_branch'."
		return 1
	fi

	if ! git "${repo_flag[@]}" worktree remove "$worktree_path"; then
		echo "Failed to remove worktree at $worktree_path."
		return 1
	fi
	echo "Removed worktree at $worktree_path."


	# Delete the branch.
	git "${repo_flag[@]}" branch -D "$full_branch" 2>/dev/null && \
		echo "Deleted branch '$full_branch'."

	# Close the tmux window if it exists.
	tmux kill-window -t "$branch" 2>/dev/null && \
		echo "Closed tmux window '$branch'."
}

# Iterate all worktrees and remove those whose PR is closed or merged.
# Accepts optional git -C flags forwarded from wtd.
_wtd_cleanup_merged() {
	local repo_flag=("$@")
	local repo_dir
	repo_dir=$(git "${repo_flag[@]}" rev-parse --show-toplevel 2>/dev/null) || {
		echo "Failed to resolve repository path."
		return 1
	}

	local main_worktree
	main_worktree=$(git "${repo_flag[@]}" worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }')

	local found=0
	local wt_path wt_branch branch_name pr_state short_branch
	while IFS=$'\t' read -r wt_path wt_branch; do
		# Skip the main worktree.
		if [ "$wt_path" = "$main_worktree" ]; then
			continue
		fi

		# Strip refs/heads/ prefix to get the branch name.
		branch_name="${wt_branch#refs/heads/}"

		# Try to find an associated PR for this branch.
		pr_state=$(cd "$repo_dir" 2>/dev/null && gh pr view "$branch_name" --json state -q '.state' 2>/dev/null) || continue

		if [ "$pr_state" = "MERGED" ] || [ "$pr_state" = "CLOSED" ]; then
			found=1
			echo "Cleaning up '$branch_name' (PR $pr_state)..."

			if ! git "${repo_flag[@]}" worktree remove "$wt_path"; then
				echo "  Failed to remove worktree at $wt_path, skipping."
				continue
			fi
			echo "  Removed worktree at $wt_path."

			git "${repo_flag[@]}" branch -D "$branch_name" 2>/dev/null && \
				echo "  Deleted branch '$branch_name'."

			# Close the tmux window if it exists.
			short_branch="${branch_name#caramelomartins/}"
			tmux kill-window -t "$short_branch" 2>/dev/null && \
				echo "  Closed tmux window '$short_branch'."
		fi
	done < <(git "${repo_flag[@]}" worktree list --porcelain | awk '
		/^worktree / { path = substr($0, 10) }
		/^branch / { print path "\t" substr($0, 8) }
	')

	if [ "$found" -eq 0 ]; then
		echo "No worktrees with closed or merged PRs found."
	fi
}

# Open a PR for review in a new tmux window with Claude Code.
# Creates a worktree for the PR branch, opens neovim, and runs
# Claude to review the PR automatically.
# Usage: wtr <pr-number> (inside repo) | wtr <repo-path> <pr-number> (outside repo)
wtr() {
	local repo_flag=()

	if ! git rev-parse --is-inside-work-tree &>/dev/null; then
		if [ -z "$1" ]; then
			echo "Usage (outside a repo): wtr <repo-path> <pr-number>"
			return 1
		fi
		repo_flag=(-C "$1")
		shift
	fi

	if [ -z "$1" ]; then
		if [ ${#repo_flag[@]} -gt 0 ]; then
			echo "Usage (outside a repo): wtr <repo-path> <pr-number>"
		else
			echo "Usage: wtr <pr-number>"
		fi
		return 1
	fi

	local pr="$1"

	# Resolve the repo's top-level directory so gh can run inside it.
	local repo_dir
	repo_dir=$(git "${repo_flag[@]}" rev-parse --show-toplevel 2>/dev/null) || {
		echo "Failed to resolve repository path."
		return 1
	}

	local pr_branch
	pr_branch=$(cd "$repo_dir" 2>/dev/null && gh pr view "$pr" --json headRefName -q '.headRefName') || {
		echo "Failed to fetch PR #$pr."
		return 1
	}

	git "${repo_flag[@]}" fetch -q origin "$pr_branch":"refs/remotes/origin/$pr_branch"

	local worktree_path
	local target_commit
	target_commit=$(git "${repo_flag[@]}" rev-parse "origin/$pr_branch" 2>/dev/null)
	worktree_path=$(git "${repo_flag[@]}" worktree list --porcelain | awk -v c="$target_commit" '
		/^worktree / { path = substr($0, 10) }
		/^HEAD / && substr($0, 6) == c { print path; exit }
	')

	if [ -n "$worktree_path" ]; then
		echo "Opening existing review worktree at $worktree_path."
	else
		worktree_path=$(mktemp -d "$HOME/.worktrees/XXXXXX") || return 1
		rmdir "$worktree_path"
		git "${repo_flag[@]}" worktree add "$worktree_path" "origin/$pr_branch" || return 1
	fi

	tmux new-window -n "r-$pr" -c "$worktree_path" \
		"claude '/go-review focus only on the changes in PR #$pr'"
	tmux split-window -h -t "r-$pr" -c "$worktree_path" "nvim"
	tmux split-window -v -t "r-$pr" -c "$worktree_path" -l 30%
}

# Remove a review worktree and close its tmux window.
# Usage: wtrd <pr-number> (inside repo) | wtrd <repo-path> <pr-number> (outside repo)
wtrd() {
	local repo_flag=()

	if ! git rev-parse --is-inside-work-tree &>/dev/null; then
		if [ -z "$1" ]; then
			echo "Usage (outside a repo): wtrd <repo-path> <pr-number> | wtrd <repo-path> --all"
			return 1
		fi
		repo_flag=(-C "$1")
		shift
	fi

	if [ "$1" = "--all" ]; then
		_wtrd_cleanup_all "${repo_flag[@]}"
		return $?
	fi

	if [ -z "$1" ]; then
		if [ ${#repo_flag[@]} -gt 0 ]; then
			echo "Usage (outside a repo): wtrd <repo-path> <pr-number> | wtrd <repo-path> --all"
		else
			echo "Usage: wtrd <pr-number> | wtrd --all"
		fi
		return 1
	fi

	local pr="$1"

	local repo_dir
	repo_dir=$(git "${repo_flag[@]}" rev-parse --show-toplevel 2>/dev/null) || {
		echo "Failed to resolve repository path."
		return 1
	}

	local pr_branch
	pr_branch=$(cd "$repo_dir" 2>/dev/null && gh pr view "$pr" --json headRefName -q '.headRefName') || {
		echo "Failed to fetch PR #$pr."
		return 1
	}

	local worktree_path
	worktree_path=$(git "${repo_flag[@]}" worktree list --porcelain | awk -v b="refs/remotes/origin/$pr_branch" '
		/^worktree / { path = substr($0, 10) }
		/^branch / && $0 ~ b { print path; exit }
	')

	# Review worktrees are detached, so also check by HEAD commit.
	if [ -z "$worktree_path" ]; then
		local target_commit
		target_commit=$(git "${repo_flag[@]}" rev-parse "origin/$pr_branch" 2>/dev/null)
		worktree_path=$(git "${repo_flag[@]}" worktree list --porcelain | awk -v c="$target_commit" '
			/^worktree / { path = substr($0, 10) }
			/^HEAD / && substr($0, 6) == c { print path; exit }
		')
	fi

	if [ -z "$worktree_path" ]; then
		echo "No worktree found for PR #$pr (branch '$pr_branch')."
		return 1
	fi

	if ! git "${repo_flag[@]}" worktree remove "$worktree_path"; then
		echo "Failed to remove worktree at $worktree_path."
		return 1
	fi
	echo "Removed worktree at $worktree_path."


	# Delete the local branch.
	git "${repo_flag[@]}" branch -D "$pr_branch" 2>/dev/null && \
		echo "Deleted branch '$pr_branch'."

	# Remove the worktree directory if it still exists.
	if [ -d "$worktree_path" ]; then
		rm -rf "$worktree_path" && \
			echo "Removed directory $worktree_path."
	fi

	# Close the tmux window if it exists.
	tmux kill-window -t "r-$pr" 2>/dev/null && \
		echo "Closed tmux window 'r-$pr'."
}

# Remove all review worktrees (detached HEADs under ~/.worktrees/) and
# close their tmux windows.
# Accepts optional git -C flags forwarded from wtrd.
_wtrd_cleanup_all() {
	local repo_flag=("$@")

	local main_worktree
	main_worktree=$(git "${repo_flag[@]}" worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }')

	local repo_dir
	repo_dir=$(git "${repo_flag[@]}" rev-parse --show-toplevel 2>/dev/null)

	local found=0
	local wt_path wt_type wt_head remote_branch pr_number
	while IFS=$'\t' read -r wt_path wt_type wt_head; do
		[ "$wt_path" = "$main_worktree" ] && continue
		[ "$wt_type" = "branch" ] && continue

		found=1
		echo "Cleaning up review worktree at $wt_path..."

		if ! git "${repo_flag[@]}" worktree remove "$wt_path" 2>/dev/null; then
			echo "  Failed to remove worktree, skipping."
			continue
		fi
		echo "  Removed worktree."

		if [ -d "$wt_path" ]; then
			rm -rf "$wt_path" && \
				echo "  Removed directory."
		fi

		# Resolve the PR number from the HEAD commit to close the specific tmux window.
		if [ -n "$wt_head" ] && [ -n "$repo_dir" ]; then
			remote_branch=$(git "${repo_flag[@]}" branch -r --points-at "$wt_head" 2>/dev/null | head -1 | sed 's/^[* ]*//' | sed 's@^origin/@@')
			if [ -n "$remote_branch" ]; then
				pr_number=$(cd "$repo_dir" 2>/dev/null && gh pr view "$remote_branch" --json number -q '.number' 2>/dev/null)
				if [ -n "$pr_number" ]; then
					tmux kill-window -t "r-$pr_number" 2>/dev/null && \
						echo "  Closed tmux window 'r-$pr_number'."
				fi
			fi
		fi
	done < <(git "${repo_flag[@]}" worktree list --porcelain | awk '
		/^worktree / {
			if (path != "") print path "\t" type "\t" head
			path = substr($0, 10); type = ""; head = ""
		}
		/^HEAD / { head = substr($0, 6) }
		/^branch / { type = "branch" }
		/^detached/ { type = "detached" }
		END { if (path != "") print path "\t" type "\t" head }
	')

	if [ "$found" -eq 0 ]; then
		echo "No review worktrees found."
	fi
}

# Remove all worktrees that are safe to clean up: dev worktrees with merged or
# closed PRs, and all review worktrees.
# Usage: wtc (inside repo) | wtc <repo-path> (outside repo)
wtc() {
	local repo_flag=()

	if ! git rev-parse --is-inside-work-tree &>/dev/null; then
		if [ -z "$1" ]; then
			echo "Usage (outside a repo): wtc <repo-path>"
			return 1
		fi
		repo_flag=(-C "$1")
		shift
	fi

	echo "==> Cleaning up dev worktrees with merged or closed PRs..."
	_wtd_cleanup_merged "${repo_flag[@]}"

	echo "==> Cleaning up review worktrees..."
	_wtrd_cleanup_all "${repo_flag[@]}"
}

# Show a dashboard of all worktrees with their type, branch/PR, and status.
# Usage: wts (inside repo) | wts <repo-path> (outside repo)
wts() {
	local repo_flag=()

	if ! git rev-parse --is-inside-work-tree &>/dev/null; then
		if [ -z "$1" ]; then
			echo "Usage (outside a repo): wts <repo-path>"
			return 1
		fi
		repo_flag=(-C "$1")
		shift
	fi

	local repo_dir
	repo_dir=$(git "${repo_flag[@]}" rev-parse --show-toplevel 2>/dev/null) || {
		echo "Failed to resolve repository path."
		return 1
	}

	local main_worktree
	main_worktree=$(git "${repo_flag[@]}" worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }')

	local tmux_windows
	tmux_windows=$(tmux list-windows -a -F '#{window_name}' 2>/dev/null)

	# Batch-fetch all PR metadata to avoid one gh call per worktree.
	local pr_json
	pr_json=$(cd "$repo_dir" 2>/dev/null && gh pr list --state all --json number,headRefName,state --limit 200 2>/dev/null) || pr_json="[]"

	{
	printf "TYPE\tBRANCH / PR\tPR STATE\tTMUX\tPATH\n"

	local wt_path wt_type wt_ref wt_head
	local type branch_display pr_state tmux_status branch_name short_branch remote_branch pr_number
	while IFS=$'\t' read -r wt_path wt_type wt_ref wt_head; do
		[ "$wt_path" = "$main_worktree" ] && continue

		type="" branch_display="" pr_state="-" tmux_status="-"

		if [ "$wt_type" = "branch" ]; then
			type="dev"
			branch_name="${wt_ref#refs/heads/}"
			branch_display="$branch_name"
			pr_state=$(printf '%s' "$pr_json" | jq -r --arg b "$branch_name" '.[] | select(.headRefName == $b) | .state' 2>/dev/null | head -1)
			[ -z "$pr_state" ] && pr_state="-"

			short_branch="${branch_name#caramelomartins/}"
			if echo "$tmux_windows" | grep -qxF "$short_branch"; then
				tmux_status="open"
			fi
		elif [ "$wt_type" = "detached" ]; then
			type="review"

			remote_branch=$(git "${repo_flag[@]}" branch -r --points-at "$wt_head" 2>/dev/null | head -1 | sed 's/^[* ]*//' | sed 's@^origin/@@')

			if [ -n "$remote_branch" ]; then
				pr_number=$(printf '%s' "$pr_json" | jq -r --arg b "$remote_branch" '.[] | select(.headRefName == $b) | .number' 2>/dev/null | head -1)
				pr_state=$(printf '%s' "$pr_json" | jq -r --arg b "$remote_branch" '.[] | select(.headRefName == $b) | .state' 2>/dev/null | head -1)
				[ -z "$pr_state" ] && pr_state="-"

				if [ -n "$pr_number" ]; then
					branch_display="#$pr_number $remote_branch"
					if echo "$tmux_windows" | grep -qxF "r-$pr_number"; then
						tmux_status="open"
					fi
				else
					branch_display="$remote_branch"
				fi
			else
				branch_display="(detached ${wt_head:0:8})"
			fi
		else
			continue
		fi

		printf "%s\t%s\t%s\t%s\t%s\n" "$type" "$branch_display" "$pr_state" "$tmux_status" "$wt_path"
	done < <(git "${repo_flag[@]}" worktree list --porcelain | awk '
		/^worktree / {
			if (path != "") print path "\t" type "\t" ref "\t" head
			path = substr($0, 10); type = ""; ref = ""; head = ""
		}
		/^HEAD / { head = substr($0, 6) }
		/^branch / { type = "branch"; ref = substr($0, 8) }
		/^detached/ { type = "detached"; ref = "" }
		END { if (path != "") print path "\t" type "\t" ref "\t" head }
	')
	} | column -t -s $'\t'
}
